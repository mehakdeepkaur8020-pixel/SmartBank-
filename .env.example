# SmartBank Environment Configuration

APP_NAME=SmartBank
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=smartbank-super-secret-key-change-in-production-2026-btech
SESSION_COOKIE_NAME=smartbank_session
SESSION_EXPIRE_HOURS=8

# Database Connection (SQLite by default, can be switched to MySQL or PostgreSQL)
DATABASE_URL=sqlite:///./smartbank.db

# Currency Settings (Indian Rupee - INR)
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹

# Transaction Monitoring Thresholds (Paise: ₹5,00,000.00 = 50,000,000 paise)
LARGE_TRANSACTION_THRESHOLD_CENTS=50000000

# Chatbot AI Provider Settings
# If GEMINI_API_KEY is omitted or blank, SmartBank seamlessly runs in high-performance FAQ Assistant mode.
AI_ENABLED=True
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CHATBOT_CONFIDENCE_THRESHOLD=0.25
